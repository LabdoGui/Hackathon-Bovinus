# Copie este arquivo para .env e ajuste os valores.
# Todas as configurações da aplicação vêm de variáveis de ambiente.
# NUNCA coloque o arquivo .env no controle de versão.

# --- Aplicação ---------------------------------------------------------------
APP_NAME=PratoCusto AI
# development | test | production
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
DATA_DIR=data

# --- Modos de integração (configuração inicial) -------------------------------
# Balança: mock | serial | manual
SCALE_MODE=mock
# Câmera: webcam | upload | mock
CAMERA_MODE=webcam
# Reconhecimento: mock | api | local
RECOGNITION_MODE=mock
# Banco: sqlite | postgresql
DATABASE_MODE=sqlite

# --- Banco de dados ----------------------------------------------------------
SQLITE_PATH=data/pratocusto.db
# Aplica as migrações automaticamente ao iniciar
DB_AUTO_MIGRATE=true
DB_ECHO=false

# PostgreSQL (opção futura; use DATABASE_MODE=postgresql e instale requirements-postgres.txt)
# Pode-se informar DATABASE_URL completa OU os campos separados.
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/pratocusto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pratocusto
POSTGRES_USER=pratocusto
POSTGRES_PASSWORD=

# --- Segurança / HTTP --------------------------------------------------------
# Origens permitidas (separadas por vírgula). Curingas (*) não são aceitos.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Tamanho máximo de imagens enviadas, em MB
MAX_UPLOAD_MB=5

# --- Negócio -----------------------------------------------------------------
CURRENCY=BRL
