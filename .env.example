# Copie este arquivo para .env e ajuste os valores.
# Todas as configurações da aplicação vêm de variáveis de ambiente.
# NUNCA coloque o arquivo .env no controle de versão.

# --- Aplicação ---------------------------------------------------------------
APP_NAME=PratoCusto AI
# development | test | production
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
DATA_DIR=data

# --- Modos de integração (configuração inicial) -------------------------------
# Balança: mock | serial | manual
SCALE_MODE=mock
# Câmera: webcam | upload | mock
CAMERA_MODE=webcam
# Reconhecimento: mock | api | local
RECOGNITION_MODE=mock
# Banco: sqlite | postgresql
DATABASE_MODE=sqlite

# --- Banco de dados ----------------------------------------------------------
SQLITE_PATH=data/pratocusto.db
# Aplica as migrações automaticamente ao iniciar
DB_AUTO_MIGRATE=true
DB_ECHO=false

# PostgreSQL (opção futura; use DATABASE_MODE=postgresql e instale requirements-postgres.txt)
# Pode-se informar DATABASE_URL completa OU os campos separados.
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/pratocusto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pratocusto
POSTGRES_USER=pratocusto
POSTGRES_PASSWORD=

# --- Balança: comportamento geral -------------------------------------------
# Tara padrão (peso do prato vazio), em gramas. Pode ser alterada pela API (PUT /scale/tare).
SCALE_DEFAULT_TARE_G=0
# Peso líquido mínimo para aceitar uma pesagem, em gramas
SCALE_MIN_WEIGHT_G=10
# Estabilização: N leituras seguidas com variação máxima de X gramas, dentro do tempo limite
SCALE_STABLE_SAMPLES=3
SCALE_STABLE_TOLERANCE_G=2
SCALE_STABILIZATION_TIMEOUT_S=5
SCALE_SAMPLE_INTERVAL_MS=150
# Validade de uma leitura para gerar transação, em segundos
SCALE_READING_MAX_AGE_S=300
# Mantém o simulador e a entrada manual disponíveis mesmo com balança serial
SCALE_ALLOW_MOCK_FALLBACK=true
SCALE_ALLOW_MANUAL=true

# --- Balança: simulador (SCALE_MODE=mock) ------------------------------------
SCALE_MOCK_WEIGHT_G=500
SCALE_MOCK_NOISE_G=8
SCALE_MOCK_SETTLE_SAMPLES=3
SCALE_MOCK_RESOLUTION_G=1

# --- Balança: serial (SCALE_MODE=serial) -------------------------------------
# Nenhum protocolo de fabricante é presumido. Preencha conforme o MANUAL da balança.
# Veja docs/balanca-serial.md.
SCALE_SERIAL_PORT=COM3
SCALE_SERIAL_BAUDRATE=9600
# 5, 6, 7 ou 8
SCALE_SERIAL_BYTESIZE=8
# N (nenhuma), E (par), O (ímpar), M (marca), S (espaço)
SCALE_SERIAL_PARITY=N
# 1, 1.5 ou 2
SCALE_SERIAL_STOPBITS=1
SCALE_SERIAL_TIMEOUT_S=1.0
# continuous (balança transmite sozinha) | request (envia comando e lê a resposta)
SCALE_SERIAL_PROTOCOL=continuous
# Comando enviado no modo request, com escapes (ex.: \x05). Vazio no modo continuous.
SCALE_SERIAL_REQUEST_COMMAND=
# Fim de linha da resposta, com escapes (ex.: \r\n, \r, \x03)
SCALE_SERIAL_LINE_TERMINATOR=\r\n
# Expressão regular com o grupo (?P<weight>...) e, opcionalmente, (?P<unit>g|kg)
SCALE_SERIAL_WEIGHT_REGEX=(?P<weight>[-+]?\d+(?:[.,]\d+)?)
# Expressão regular presente apenas quando o peso está estável (vazio = estabilidade por software)
SCALE_SERIAL_STABLE_REGEX=
# Unidade do número enviado pela balança quando não há grupo "unit": g | kg
SCALE_SERIAL_UNIT=kg
SCALE_SERIAL_ENCODING=ascii

# --- Câmera (OpenCV) ----------------------------------------------------------
# Índice da webcam (0 = primeira). Use GET /api/v1/camera/devices para ver as disponíveis.
CAMERA_DEVICE_INDEX=0
# auto | dshow (DirectShow) | msmf (Media Foundation) | v4l2 (Linux).
# No Windows, se a webcam não abrir ou demorar, tente dshow ou msmf.
CAMERA_BACKEND=auto
# Quantos índices sondar ao listar câmeras
CAMERA_MAX_PROBE=5
# Resolução solicitada à câmera (o driver pode escolher outra próxima)
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
# Resolução mínima aceita (imagens menores são rejeitadas)
CAMERA_MIN_WIDTH=640
CAMERA_MIN_HEIGHT=480
# Limite de pixels de imagens enviadas (proteção contra imagens gigantes)
CAMERA_MAX_PIXELS=40000000
# Quadros descartados ao abrir (ajuste de exposição) e antes de cada captura (buffer antigo)
CAMERA_WARMUP_FRAMES=5
CAMERA_FLUSH_FRAMES=2
# Tempo máximo esperando a câmera responder, em segundos
CAMERA_TIMEOUT_S=5
CAMERA_JPEG_QUALITY=90
# Pré-visualização
CAMERA_PREVIEW_FPS=5
CAMERA_PREVIEW_WIDTH=640
CAMERA_PREVIEW_MAX_SECONDS=300
# Qualidade da imagem: limiares heurísticos, ajuste conforme a iluminação do local
CAMERA_DARK_THRESHOLD=40
CAMERA_BRIGHT_THRESHOLD=235
CAMERA_BLUR_THRESHOLD=100
CAMERA_EMPTY_STDDEV_THRESHOLD=4

# --- Reconhecimento de alimentos ---------------------------------------------
# Confiança mínima por alimento; abaixo disso o resultado vai para revisão humana (0 a 1)
RECOGNITION_MIN_CONFIDENCE=0.70
# Diferença máxima aceita entre a soma das proporções e 1 antes de sinalizar inconsistência
RECOGNITION_PROPORTION_TOLERANCE=0.05
RECOGNITION_MAX_DETECTIONS=20

# Modo mock (SIMULADO, sem modelo treinado). Cenário: random | confident | uncertain |
# unknown_food | empty | failure (para testar cada fluxo)
RECOGNITION_MOCK_SCENARIO=random
# Transações vindas do mock sempre vão para revisão (evita tratar dados simulados como reais)
RECOGNITION_MOCK_REQUIRES_REVIEW=true

# Modo api: API externa que siga o contrato descrito em docs/reconhecimento.md.
# A URL precisa ser HTTPS (http só para localhost). NUNCA coloque a chave no código ou no Git.
RECOGNITION_API_URL=
RECOGNITION_API_KEY=
RECOGNITION_API_AUTH_HEADER=Authorization
# Prefixo do valor do cabeçalho (ex.: Bearer). Vazio = enviar só a chave.
RECOGNITION_API_AUTH_SCHEME=Bearer
RECOGNITION_API_TIMEOUT_S=15
RECOGNITION_API_MAX_RESPONSE_KB=512

# Modo local: estrutura preparada, sem modelo fornecido (ver docs/reconhecimento.md)
RECOGNITION_LOCAL_MODEL_PATH=

# --- Relatórios e revisão ----------------------------------------------------
# Fuso horário dos relatórios (dias, CSV). No Windows é preciso o pacote tzdata (já em requirements.txt).
APP_TIMEZONE=America/Sao_Paulo
REPORT_DEFAULT_DAYS=30
REPORT_MAX_DAYS=366
# Tolerância ao corrigir por peso: a soma dos pesos pode diferir do peso líquido até o MAIOR entre
# estes dois valores (g e %); dentro dela, os pesos são reescalados para somar o peso líquido
REVIEW_WEIGHT_TOLERANCE_G=5
REVIEW_WEIGHT_TOLERANCE_PCT=2

# --- Segurança / HTTP --------------------------------------------------------
# Origens permitidas (separadas por vírgula). Curingas (*) não são aceitos.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Tamanho máximo de imagens enviadas, em MB
MAX_UPLOAD_MB=5

# --- Negócio -----------------------------------------------------------------
CURRENCY=BRL
# Preço padrão cobrado por kg (R$). VALOR ILUSTRATIVO: ajuste para o preço real.
# Cada transação pode informar outro preço (price_per_kg).
DEFAULT_PRICE_PER_KG=59.90
